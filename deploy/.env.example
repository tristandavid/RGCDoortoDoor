# Copy to /opt/rgcdoortodoor/.env on the server (NOT into git) and fill in
# real values. systemd's EnvironmentFile= loads this directly — plain
# KEY=VALUE lines, no "export", no quotes needed around simple values.

SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional second FULL admin login (e.g. a co-owner or manager) — same
# access as the owner login above, just separate credentials and its own
# two-factor enrollment. Leave BOTH blank/unset to not have this second
# login at all — it only exists once both are set.
ADMIN2_USERNAME=
ADMIN2_PASSWORD=

# Optional third, RESTRICTED login for whoever maintains the site
# (developer/technical support) — separate credentials, restricted to
# Updates/Products/Pages/Settings (no Orders, Invoices, Mailbox, Pickups, or
# Subscribers; see the comment above ADMIN_USERNAME in app.py). Leave BOTH
# blank/unset to not have this login at all — it only exists once both are
# set.
CREATOR_USERNAME=
CREATOR_PASSWORD=

# Optional "Sign in with Google" for the customer portal (see the comment
# above GOOGLE_CLIENT_ID in app.py for how to get these from the Google
# Cloud Console, and the exact redirect URI to authorize there). Leave BOTH
# blank/unset to not show the Google button at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local Postgres (see README: "Step 5 — set up Postgres")
DATABASE_URL=postgresql://rgc:replace-with-db-password@localhost:5432/rgc

# Outbound email via Microsoft 365 SMTP (see README: "Sending email via
# Microsoft 365 SMTP") — the info@ mailbox's own sign-in credentials
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=info@rgcdoortodoorboxservices.ca
SMTP_PASSWORD=replace-with-the-mailbox-password
CONTACT_RECIPIENT_EMAIL=info@rgcdoortodoorboxservices.ca

# Self-hosted 24/7, so the free-tier keep-alive doesn't apply — leave unset.
KEEP_ALIVE_ENABLED=false
